{
  "name": "rotation-engine",
  "private": true,
  "version": "5.0.0",
  "description": "ED Assignment Rotation Engine — TypeScript monorepo",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @rotation/api dev\" \"pnpm --filter @rotation/web dev\"",
    "dev:api": "pnpm --filter @rotation/api dev",
    "dev:web": "pnpm --filter @rotation/web dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @rotation/engine --filter @rotation/db --filter @rotation/api test",
    "seed": "pnpm --filter @rotation/api exec tsx src/seed.ts",
    "cli": "pnpm --filter @rotation/cli exec tsx src/index.ts",
    "lint": "pnpm -r --if-present typecheck",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
