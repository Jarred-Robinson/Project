{
  "name": "rotation-engine",
  "private": true,
  "version": "1.0.0",
  "description": "ED Assignment Rotation Engine — TypeScript monorepo",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @rotation/api dev\" \"pnpm --filter @rotation/web dev\"",
    "test": "pnpm --filter @rotation/engine test",
    "cli": "pnpm --filter @rotation/cli start --",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
